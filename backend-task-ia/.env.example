DATABASE_URL=sqlite:///./app.db
JWT_SECRET=cambiar-en-produccion
JWT_ALGORITHM=HS256

# Coloca aquí tu clave de OpenAI (opcional).
# Déjala vacía si aún no la tienes: la autenticación y la
# clasificación SVM funcionan sin ella. Solo el módulo de
# recomendación (/recommend) requerirá la clave.
OPENAI_API_KEY=

# Opcional: restringe los orígenes CORS (separados por coma).
# Vacío o "*" permite cualquier origen.
# Ejemplo: ALLOWED_ORIGINS=https://mi-app.vercel.app
ALLOWED_ORIGINS=