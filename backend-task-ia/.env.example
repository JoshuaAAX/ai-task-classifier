DATABASE_URL=sqlite:///./app.db
JWT_SECRET=cambiar-en-produccion
JWT_ALGORITHM=HS256

# Coloca aquí tu clave de OpenAI (opcional).
# Déjala vacía si aún no la tienes: la autenticación y la
# clasificación SVM funcionan sin ella. Solo el módulo de
# recomendación (/recommend) requerirá la clave.
OPENAI_API_KEY=

# Opcional: restringe los orígenes CORS (separados por coma).
# Vacío o "*" permite cualquier origen.
# Ejemplo: ALLOWED_ORIGINS=https://mi-app.vercel.app
ALLOWED_ORIGINS=

# URL pública del frontend (se usa para armar el enlace de recuperación).
# Ejemplo: APP_URL=https://mi-app.vercel.app
APP_URL=

# Opcional: SMTP para enviar el correo de recuperación de contraseña.
# Si no se configura, la API devuelve el enlace en la respuesta (modo demo).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=